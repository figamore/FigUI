{
  "name": "figui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-icons.mjs && vite",
    "build": "node scripts/generate-icons.mjs && tsc && vite build",
    "build:esp32": "node scripts/generate-icons.mjs && tsc && node scripts/build-esp32.mjs",
    "build:demo": "node scripts/generate-icons.mjs && tsc && vite build --mode demo",
    "build:studio": "node scripts/build-config-studio.mjs",
    "test": "node scripts/run-tests.mjs && npm run -s test:webui && npm run -s test:resources",
    "test:config": "node scripts/test-config-compatibility.mjs",
    "test:settings": "esbuild scripts/test-settings-values.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-settings-values.mjs && node node_modules/.cache/figui-test-settings-values.mjs",
    "test:jog": "node scripts/test-jog-settings.mjs",
    "test:plugins-macros": "esbuild scripts/test-plugins-macros.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-plugins-macros.mjs && node node_modules/.cache/figui-test-plugins-macros.mjs",
    "test:gcode-parser": "esbuild scripts/test-gcode-parser.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-gcode-parser.mjs && node node_modules/.cache/figui-test-gcode-parser.mjs",
    "test:gcode-arcs": "esbuild scripts/test-gcode-arcs.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-gcode-arcs.mjs && node node_modules/.cache/figui-test-gcode-arcs.mjs",
    "test:probe-absolute-mode": "esbuild scripts/test-probe-absolute-mode.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-probe-absolute-mode.mjs && node node_modules/.cache/figui-test-probe-absolute-mode.mjs",
    "test:gcode": "esbuild scripts/test-gcode-preview.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-gcode-preview.mjs && node node_modules/.cache/figui-test-gcode-preview.mjs",
    "test:gcode-restart": "esbuild scripts/test-gcode-restart.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-gcode-restart.mjs && node node_modules/.cache/figui-test-gcode-restart.mjs",
    "test:drill": "esbuild scripts/test-drill-markers.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-drill-markers.mjs && node node_modules/.cache/figui-test-drill-markers.mjs",
    "test:job-timing": "esbuild scripts/test-job-timing.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-job-timing.mjs && node node_modules/.cache/figui-test-job-timing.mjs",
    "test:fine-jog": "esbuild scripts/test-fine-jog.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-fine-jog.mjs && node node_modules/.cache/figui-test-fine-jog.mjs",
    "test:gcode-cache": "esbuild scripts/test-gcode-cache.ts --bundle --packages=external --platform=node --format=esm --outfile=node_modules/.cache/figui-test-gcode-cache.mjs && node node_modules/.cache/figui-test-gcode-cache.mjs",
    "test:stream": "esbuild scripts/test-gcode-stream.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-gcode-stream.mjs && node node_modules/.cache/figui-test-gcode-stream.mjs",
    "test:job-guards": "esbuild scripts/test-job-guards.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-job-guards.mjs && node node_modules/.cache/figui-test-job-guards.mjs",
    "test:controller-jobs": "esbuild scripts/test-controller-jobs.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-controller-jobs.mjs && node node_modules/.cache/figui-test-controller-jobs.mjs",
    "test:parser": "esbuild scripts/test-status-parser.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-status-parser.mjs && node node_modules/.cache/figui-test-status-parser.mjs",
    "test:running-file": "esbuild scripts/test-running-file.ts --bundle --packages=external --platform=node --format=esm --outfile=node_modules/.cache/figui-test-running-file.mjs && node node_modules/.cache/figui-test-running-file.mjs",
    "test:webui": "esbuild scripts/test-webui-blocked.tsx --bundle --packages=external --loader:.svg=dataurl --platform=node --format=esm --outfile=node_modules/.cache/figui-test-webui-blocked.mjs && node node_modules/.cache/figui-test-webui-blocked.mjs",
    "test:http-files": "esbuild scripts/test-http-files.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-http-files.mjs && node node_modules/.cache/figui-test-http-files.mjs",
    "test:resources": "esbuild scripts/test-resource-loading.tsx --bundle --external:react --external:react-dom --external:lucide-react --external:zustand --loader:.svg=dataurl --define:import.meta.env='{}' --define:import.meta.env.DEV=false --define:__CONFIG_STUDIO_BUILD__='\"test\"' --platform=node --format=esm --outfile=node_modules/.cache/figui-test-resource-loading.mjs && node node_modules/.cache/figui-test-resource-loading.mjs",
    "test:transport": "esbuild scripts/test-transport.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-transport.mjs && node node_modules/.cache/figui-test-transport.mjs",
    "test:terminal": "esbuild scripts/test-terminal.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-terminal.mjs && node node_modules/.cache/figui-test-terminal.mjs",
    "preview": "vite preview",
    "test:studio": "node scripts/test-config-studio-loader.mjs",
    "test:plugin-close": "esbuild scripts/test-plugin-close.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-plugin-close.mjs && node node_modules/.cache/figui-test-plugin-close.mjs",
    "test:pack": "node scripts/test-esp32-pack.mjs",
    "test:line-gate": "esbuild scripts/test-line-gate.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-line-gate.mjs && node node_modules/.cache/figui-test-line-gate.mjs",
    "test:continuous-jog": "esbuild scripts/test-continuous-jog.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-continuous-jog.mjs && node node_modules/.cache/figui-test-continuous-jog.mjs",
    "test:gcode-files": "esbuild scripts/test-gcode-files.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-gcode-files.mjs && node node_modules/.cache/figui-test-gcode-files.mjs",
    "test:gcode-framing": "esbuild scripts/test-gcode-framing.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/figui-test-gcode-framing.mjs && node node_modules/.cache/figui-test-gcode-framing.mjs"
  },
  "dependencies": {
    "codejar": "^4.3.0",
    "lucide-react": "^0.462.0",
    "preact": "^10.29.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@gfx/zopfli": "^1.0.15",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "fake-indexeddb": "^6.2.5",
    "lightningcss": "^1.33.0",
    "lzma": "2.3.2",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.14",
    "tailwindcss-patch": "^9.4.4",
    "terser": "^5.49.0",
    "typescript": "^5.6.0",
    "unplugin-tailwindcss-mangle": "^5.1.4",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.1"
  }
}
